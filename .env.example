# --- Required in production ---
#
# `src/lib/env.ts` only falls back to the dev defaults below when
# NODE_ENV !== 'production'. A real production deploy that omits any of
# the variables marked required crashes at boot with a readable zod error
# (which the platform sees as a healthcheck failure) — *do not* take the
# dev values as a working production config.

# Canonical site URL: the address family devices open, e.g.
# https://exam.example.com or http://192.168.1.20:3000. Used for the absolute
# links in magic-link sign-in emails and household invite URLs, and it decides
# the session cookie: https -> Secure `__Host-examify_session`; plain http ->
# non-Secure `examify_session`. localhost only works on the host machine.
# Plain http is unencrypted; use HTTPS (a reverse proxy) beyond your home network.
SITE_URL=http://localhost:3000

# >=32 char secret. Signs the session cookie.
# Generate with: openssl rand -base64 32
# Production rejects this documented placeholder (and the DEV_ONLY default).
AUTH_SECRET=replace-me-with-a-32+-char-random-string

# Family data folder — the one setting for where this family's data lives:
# the SQLite database (app.db), the local mail outbox, and everything the
# /onboarding wizard writes (subjects, uploaded study PDFs, generated
# questions and answer keys) plus ingest caches and backups. The running app
# never writes inside the checkout. A relative path resolves against this
# checkout (never the working directory); inside the checkout only ./data
# (already gitignored) or a folder under it is allowed. A leading ~ or a $VAR
# is never expanded here: write an absolute path. It must be a folder of its
# own (a folder already holding other software's files is refused). Pick a folder outside
# the checkout (e.g. /var/lib/examify) if you might ever delete and re-clone
# it. `pnpm db:migrate` creates it (0700). Production requires
# EXAMIFY_DATA_DIR or DATABASE_URL, so a deploy without persistent storage
# fails boot instead of writing to ephemeral disk.
EXAMIFY_DATA_DIR=./data

# Optional SQLite override. Unset → <EXAMIFY_DATA_DIR>/app.db. Existing
# installs keep DATABASE_URL=file:./data/app.db (the same file). With
# EXAMIFY_DATA_DIR unset, a DATABASE_URL outside the checkout (for example
# file:/data/app.db on a mounted volume) makes that folder the data folder.
# Relative paths resolve against the checkout; inside the checkout only
# ./data/… is allowed (anything else is refused, boot included).
# DATABASE_URL=file:./data/app.db

# Access is invite-only and managed in the app (households / members /
# invites in SQLite). There is no FAMILIES env JSON. On a fresh install,
# open the app and create the first household at /setup. Invite students
# and other parents from the parent dashboard.
#
# Existing deploys that still have a FAMILIES= JSON value: leave it set
# for one boot after upgrading. If the DB has no households yet, Examify
# imports that JSON once (one household per family that has ≥1 parent)
# and you can then delete the env var. Entries with parents: [] are
# skipped (they would be unadministrable). In production, a set-but-invalid
# FAMILIES value crashes boot (fix the JSON or unset it).

# Required in production (min 16). The /setup form must present this
# exact code before the first household/admin can be created. CAPTCHA
# is not identity — without this, a stranger can claim a fresh deploy.
# Dev/test default is applied only when NODE_ENV !== 'production'.
# Production rejects documented placeholders (this replace-me value,
# the dev default). Generate with: openssl rand -base64 24
SETUP_BOOTSTRAP_SECRET=replace-me-with-a-16+-char-random-string

# How people sign in. Default magic-link keeps existing installs working.
#   password    — email + password; sign-in needs no mail. Invite accept
#                 still sends a mailbox OTP (SMTP / Resend / allowed outbox)
#                 and fails closed if none can deliver. Forgot password
#                 uses that same mailbox OTP and does not change the hash
#                 until the code is consumed. `install.sh`
#                 default password mode enables a local outbox when no
#                 SMTP / Resend is set so kid invites are not stranded.
#   magic-link  — one-time URL via Resend, SMTP, or the local outbox
#   local-otp   — 6-digit code (outbox / email). Production requires
#                 ALLOW_LOCAL_OUTBOX=1
# `install.sh` writes this. Change + restart to switch modes. Switching
# to password leaves members with no hash unable to sign in until they
# use Forgot password (mailbox OTP). Re-invite does not replace a
# current member's password.
AUTH_MODE=magic-link

# How magic-link / OTP messages are delivered.
#   auto    — SMTP if SMTP_HOST is set, else Resend if a real key, else outbox
#   resend  — requires a real RESEND_API_KEY + RESEND_FROM
#   smtp    — requires SMTP_HOST + SMTP_FROM
#   outbox  — production requires ALLOW_LOCAL_OUTBOX=1
MAIL_TRANSPORT=auto

# Resend API key + verified From: address. Unset writes emails to the
# local outbox (<EXAMIFY_DATA_DIR>/outbox, or MAIL_OUTBOX_DIR) in development.
# Production with no real key does NOT write bearer tokens to the outbox
# unless you set ALLOW_LOCAL_OUTBOX=1 (dangerous opt-in). A real (non-test)
# RESEND_API_KEY requires RESEND_FROM.
# RESEND_API_KEY=re_...
# RESEND_FROM=Examify <you@your-verified-domain>
# Test/dev only: RESEND_API_KEY=test keeps dev/test mail in tests/.tmp/outbox.
# It is not a mail path in production and never replaces ALLOW_LOCAL_OUTBOX.
# RESEND_API_KEY=test

# User-configured SMTP (magic-link / OTP). SMTP_FROM is required only when
# SMTP is the active transport: MAIL_TRANSPORT=smtp, or MAIL_TRANSPORT=auto
# and SMTP_HOST is set. A leftover SMTP_HOST does not fail boot when
# MAIL_TRANSPORT is resend or outbox. AUTH/DATA on a connection that never
# upgraded to TLS is refused unless SMTP_ALLOW_INSECURE=1.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Examify <you@example.com>
# SMTP_ALLOW_INSECURE=1

# Optional override for the local mail outbox directory (default
# <EXAMIFY_DATA_DIR>/outbox; a relative path resolves against the checkout).
# It holds sign-in bearer tokens: outside the checkout, or under ./data (the
# test suites use tests/.tmp); anything else inside the checkout is refused.
# Backups never copy it, so it must be a folder of its own: not the data
# folder itself, a folder containing it, or one of its content folders (or
# a folder inside one, such as a subject's).
# Writer and tests share this path when set.
# MAIL_OUTBOX_DIR=tests/.tmp/outbox
# Production-only dangerous opt-in to write magic-link tokens locally.
# ALLOW_LOCAL_OUTBOX=1

# Optional. Anthropic API key for free-text grading and `examify-ingest
# generate --provider anthropic` (CLI and /onboarding AI step). Not required
# at production boot — wizard clear removes this line and a restart will
# not brick the app. Missing / empty fail-closes grading (`needs_review`)
# and Cloud generate. Set to "test" locally to use a deterministic
# full-score stub (no network). The stub only runs outside production, or
# with GRADING_STUB=1; a production `test` means "no key" (answers saved,
# not marked). Marking sends each free-text answer with its question and
# rubric to Anthropic.
# install.sh and the /onboarding AI step write this same repo-root `.env`
# store (set / rotate / clear; `findRepoRoot`, not process.cwd()).
# The wizard never echoes the value. examify-ingest generate fills
# unset keys from this file using the same root walk.
# A Docker / systemd / parent-process inject is host-managed if the key
# is present in the process exec environment (including empty / `test`).
# The wizard refuses rotate/clear — mergeRepoEnvFiles leaves that
# existing env alone after restart. Change the key in that host env.
# The `test` sentinel is refused for generate — use `--provider test` in CI.
# Never put a real key in BankIR or committed files.
ANTHROPIC_API_KEY=test

# Test/CI only. Lets the ANTHROPIC_API_KEY=test stub grade under
# NODE_ENV=production (the Playwright configs run `next start`). Never set it
# on a real host: every free-text answer would get full marks.
# GRADING_STUB=1

# Optional. Used only by `examify-ingest generate --provider openai`
# (CLI and /onboarding AI step). Not in Next env.ts; never NEXT_PUBLIC_*.
# OpenAI generate from PDFs needs `pdftoppm` (poppler-utils) on PATH.
# install.sh and the /onboarding AI step write this same repo-root `.env`
# store (set / rotate / clear; `findRepoRoot`, not process.cwd()).
# The wizard never echoes the value back. examify-ingest generate fills
# unset keys from this file using the same root walk.
# A Docker / systemd / parent-process inject is host-managed if the key
# is present in the process exec environment (including empty / `test`).
# The wizard refuses rotate/clear — mergeRepoEnvFiles leaves that
# existing env alone after restart. Change the key in that host env.
# OPENAI_API_KEY=

# Claude Code / Codex (the /onboarding "Claude Code" and "Codex" modes;
# `examify-ingest generate --provider claude-cli|codex-cli`). They use the
# CLI's own sign-in (your Claude or ChatGPT plan), so no API key here: install
# the CLI as the user that runs Examify and sign in once (`claude`, or
# `codex login`; headless: CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`,
# or CODEX_API_KEY, set in that user's environment). Examify finds the binary
# on PATH or in ~/.local/bin; set these when it lives elsewhere (full path).
# The CLI gets no tools and only an allowlist of env vars (PATH, HOME, locale,
# proxy / CA settings, its own config dir and token) — never this file's
# secrets or API keys. Models default to the CLI's own choice.
# EXAMIFY_CLAUDE_BIN=/home/examify/.local/bin/claude
# EXAMIFY_CLAUDE_MODEL=sonnet
# EXAMIFY_CODEX_BIN=/usr/local/bin/codex
# EXAMIFY_CODEX_MODEL=

# Optional local endpoint for `examify-ingest generate --provider local` and
# the /onboarding "Local endpoint" mode: OpenAI-compatible
# /v1/chat/completions (Ollama, LM Studio, llama.cpp server, …). Not a secret.
# EXAMIFY_LLM_MODEL is the model name it gets (Ollama: one `ollama list`
# shows; a vision model reads PDF page images). The wizard needs both.
# EXAMIFY_LLM_BASE_URL=http://127.0.0.1:11434
# EXAMIFY_LLM_MODEL=llama3.2-vision
# Or your own command (the /onboarding "Local command" mode): an executable
# that reads a JSON request on stdin (prompt, subject, sources with text or
# base64 bytes, page images) and writes BankIR JSON to stdout. Quote paths
# with spaces. The wizard's "Local endpoint" mode never runs this command,
# and "Local command" never calls the URL.
# EXAMIFY_INGEST_LOCAL_CMD="/usr/local/bin/my-bank-generator" --json

# --- Always optional ---

# Cloudflare Turnstile captcha. OFF by default — local / LAN / simple self-hosts
# need no Cloudflare account. To enable:
#   1. Set TURNSTILE_ENABLED=1
#   2. Set both site + secret keys below
# Keys alone do not turn captcha on. Setting exactly one key in production
# crashes boot. Dummy keys for local/e2e (always-pass / always-fail):
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
#   fail:   2x00000000000000000000AB / 2x0000000000000000000000000000000AA
# TURNSTILE_ENABLED=1
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# When PLAUSIBLE_DOMAIN is set, the analytics script renders. Otherwise it
# stays off (no third-party traces in dev by default).
# PLAUSIBLE_DOMAIN=examify.example.com
# PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Sign-in rate-limit override. A single per-IP bucket for every magic-link
# request (uniform threshold, so it can't reveal which emails already exist).
# Default: 10 per 1h per IP.
# RATE_LIMIT_SIGNIN_MAX=10
# RATE_LIMIT_SIGNIN_WINDOW_MS=3600000

# The one header the rate limiter trusts for the client IP. Others are ignored.
#   x-forwarded-for  (default) rightmost X-Forwarded-For hop; any single reverse
#                    proxy that appends to XFF (Caddy, Traefik, nginx, PaaS edges)
#   x-real-ip        only if your proxy OVERWRITES X-Real-IP with the peer address
#   cf-connecting-ip only if the origin is reachable exclusively via Cloudflare
# An unknown value fails boot.
# CLIENT_IP_HEADER=x-forwarded-for

# Session cookie name override (rarely needed). Unset follows SITE_URL:
# `__Host-examify_session` on https, `examify_session` on plain http. A
# `__Host-` / `__Secure-` name needs an https SITE_URL (production boot fails
# otherwise).
# SESSION_COOKIE_NAME=examify_session
