# --- Required in production ---
#
# `src/lib/env.ts` only falls back to the dev defaults below when
# NODE_ENV !== 'production'. A real production deploy that omits any of
# the variables marked required crashes at boot with a readable zod error
# (which the platform sees as a healthcheck failure) — *do not* take the
# dev values as a working production config.

# Canonical site URL. Used for the absolute links in magic-link sign-in
# emails and household invite URLs. In production, set this to the app's
# public domain.
SITE_URL=http://localhost:3000

# >=32 char secret. Signs the session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32+-char-random-string

# SQLite file path. In production, point this at runtime-mounted persistent
# storage, for example DATABASE_URL=file:/data/app.db.
DATABASE_URL=file:./data/app.db

# Access is invite-only and managed in the app (households / members /
# invites in SQLite). There is no FAMILIES env JSON. On a fresh install,
# open the app and create the first household at /setup. Invite students
# and other parents from the parent dashboard.
#
# Existing deploys that still have a FAMILIES= JSON value: leave it set
# for one boot after upgrading. If the DB has no households yet, Examify
# imports that JSON once (one household per family entry) and you can
# then delete the env var. Malformed leftover JSON is skipped with a
# warning — it no longer crashes boot.

# Resend API key + verified From: address. Optional. Unset or "test"
# writes magic-link emails to a local outbox instead of sending
# (tests/.tmp/outbox when key=test; data/outbox in production with no key).
# Magic-link sign-in still works; family members just need a way to open
# the link (the outbox file, or a real Resend key).
# TODO(multi-auth): the install wizard will later let hosts pick
# magic-link / passkey / password / SMTP — do not hard-require Resend.
RESEND_API_KEY=test
RESEND_FROM=Examify <onboarding@resend.dev>

# Anthropic API key for free-text grading. Set to "test" locally to use a
# deterministic full-score stub instead of calling the API (no network).
ANTHROPIC_API_KEY=test

# --- Always optional ---

# Cloudflare Turnstile. Off when both keys are unset (the default for a
# new self-host). When both site + secret are set, the login/setup/invite
# forms show the widget and the server verifies the token. Dummy keys
# for local/e2e (always-pass / always-fail):
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
#   fail:   2x00000000000000000000AB / 2x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# When PLAUSIBLE_DOMAIN is set, the analytics script renders. Otherwise it
# stays off (no third-party traces in dev by default).
# PLAUSIBLE_DOMAIN=examify.example.com
# PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Sign-in rate-limit override. A single per-IP bucket for every magic-link
# request (uniform threshold, so it can't reveal which emails already exist).
# Default: 10 per 1h per IP.
# RATE_LIMIT_SIGNIN_MAX=10
# RATE_LIMIT_SIGNIN_WINDOW_MS=3600000

# Cookie name override (rarely needed).
# SESSION_COOKIE_NAME=__Host-examify_session
