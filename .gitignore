# dependencies
node_modules
.pnpm-store

# next (install.sh --upgrade parks the old build here until the new one is verified)
.next
/.next.pre-upgrade-*
out
build

# env (all hold secrets; a restore can write any of them)
.env
.env.local
.env.*.local
/.env.production

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
.idea
.vscode/*
!.vscode/settings.json

# test / coverage
coverage
playwright-report
test-results
.nyc_output
tests/.tmp

# local sqlite + drizzle generated artifacts
*.db
*.db-journal
*.db-wal
*.db-shm
/data

# next typed routes / cache
next-env.d.ts
*.tsbuildinfo

# source exam PDFs — kept local-only; only the questions authored from them
# (with provenance) are committed (see docs/content-authoring.md)
content/source-pdfs/

# examify-ingest generate cache + run manifests (source hashes, never API keys)
.examify-ingest/
