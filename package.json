{
  "name": "project-examify",
  "version": "0.1.0",
  "private": true,
  "description": "Examify — a calm, mobile-first, self-hosted exam-practice app for families. Password or magic-link auth, SQLite, LLM-graded free-text.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atk0309/project_Examify.git"
  },
  "homepage": "https://github.com/atk0309/project_Examify#readme",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:prepare && pnpm test:e2e:seeded && pnpm test:e2e:prepare:fresh && pnpm test:e2e:fresh",
    "test:e2e:seeded": "pnpm build && MAIL_OUTBOX_DIR=tests/.tmp/e2e-outbox playwright test",
    "test:e2e:fresh": "MAIL_OUTBOX_DIR=tests/.tmp/e2e-fresh-outbox playwright test -c playwright.fresh.config.ts",
    "test:e2e:prepare": "MAIL_OUTBOX_DIR=tests/.tmp/e2e-outbox tsx tests/e2e/setup-db.ts",
    "test:e2e:prepare:fresh": "E2E_DB_PATH=tests/.tmp/e2e-fresh.db MAIL_OUTBOX_DIR=tests/.tmp/e2e-fresh-outbox tsx tests/e2e/setup-db.ts --empty",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "examify-ingest": "tsx tools/examify-ingest/src/main.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "iron-session": "9.0.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.27.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "examify-ingest": "workspace:0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.4.1",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1",
      "vite@<8.0.16": ">=8.0.16",
      "postcss@<8.5.10": ">=8.5.10",
      "sharp@<0.35.4": "0.35.4",
      "nanoid@<3.3.18": "3.3.18",
      "js-yaml@<4.3.2": "4.3.2",
      "undici@<7.29.0": "7.29.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
